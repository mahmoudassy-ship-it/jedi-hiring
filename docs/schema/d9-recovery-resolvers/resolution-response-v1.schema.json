{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/resolution-response-v1.schema.json",
  "title": "JEDI Atlas recovery projection resolution response",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "resolver_kind_code", "response_code", "operation_id", "operation_nonce", "request_record_digest_sha256", "idempotency_key_sha256", "sender", "recipient", "runtime_generation", "subject", "result_code", "error_code", "observed_at", "responded_at", "append_revalidate_by", "source_observations", "projection", "technical_evidence_only", "authority_granted", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-recovery-projection-resolution-response" },
    "format_version": { "const": "1.0.0" },
    "resolver_kind_code": { "enum": ["d901_control_access", "d920_accepted_evidence", "d930_custody", "d940_composite_snapshot"] },
    "response_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/operationNonce" },
    "request_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
    "idempotency_key_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
    "sender": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/serviceIdentity" },
    "recipient": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/serviceIdentity" },
    "runtime_generation": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/runtimeGeneration" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/subject" },
    "result_code": { "enum": ["resolved", "unavailable", "ambiguous", "reconciliation_required"] },
    "error_code": { "type": ["string", "null"], "enum": [null, "source_unavailable", "source_head_moved", "source_head_missing", "source_head_stale", "source_head_future", "source_head_forked", "source_head_gapped", "source_head_rolled_back", "source_substituted", "source_contradictory", "mixed_generation", "mixed_profile", "mixed_subject", "mixed_source_head", "replay_collision", "global_snapshot_unprovable"] },
    "observed_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
    "responded_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
    "append_revalidate_by": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
    "source_observations": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sourceObservation" } },
    "projection": {
      "type": ["object", "null"],
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["projection_kind_code", "journal_namespace_code", "known_through_receipt_sequence", "known_through_persisted_at", "control_ledger_head_receipt_digest_sha256", "control_head_projection_sha256", "access_head_projection_sha256", "projection_sha256"],
          "properties": {
            "projection_kind_code": { "const": "d901_control_access" },
            "journal_namespace_code": { "const": "d940.global.control-journal.v1" },
            "known_through_receipt_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/positiveInteger" },
            "known_through_persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
            "control_ledger_head_receipt_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "control_head_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "access_head_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["projection_kind_code", "known_through_bundle_sequence", "accepted_receipt_prefix_sha256", "accepted_logical_state_sha256", "subject_lineage_projection_sha256", "projection_sha256"],
          "properties": {
            "projection_kind_code": { "const": "d920_accepted_evidence" },
            "known_through_bundle_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/positiveInteger" },
            "accepted_receipt_prefix_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "accepted_logical_state_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "subject_lineage_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["projection_kind_code", "known_through_journal_sequence", "known_through_journal_persisted_at", "custody_journal_head_digest_sha256", "primary_receipt_prefix_sha256", "custody_leaf_projection_sha256", "projection_sha256"],
          "properties": {
            "projection_kind_code": { "const": "d930_custody" },
            "known_through_journal_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/positiveInteger" },
            "known_through_journal_persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
            "custody_journal_head_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "primary_receipt_prefix_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "custody_leaf_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["projection_kind_code", "consistency_code", "source_response_record_digests", "snapshot", "snapshot_digest_sha256", "projection_sha256"],
          "properties": {
            "projection_kind_code": { "const": "d940_composite_snapshot" },
            "consistency_code": { "const": "stable_double_collect_no_atomic_global_snapshot" },
            "source_response_record_digests": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" } },
            "snapshot": {
              "type": "object", "additionalProperties": false,
              "required": ["journal_namespace_code", "known_through_receipt_sequence", "known_through_persisted_at", "control_ledger_head_receipt_digest_sha256", "control_head_projection_sha256", "access_head_projection_sha256", "subject_lineage_projection_sha256", "inventory_snapshot_sha256", "custody_leaf_projection_sha256"],
              "properties": {
                "journal_namespace_code": { "const": "d940.global.control-journal.v1" },
                "known_through_receipt_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/positiveInteger" },
                "known_through_persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
                "control_ledger_head_receipt_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
                "control_head_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
                "access_head_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
                "subject_lineage_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
                "inventory_snapshot_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
                "custody_leaf_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
              }
            },
            "snapshot_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
            "projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
          }
        }
      ]
    },
    "technical_evidence_only": { "const": true },
    "authority_granted": { "const": false },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
  }
}
