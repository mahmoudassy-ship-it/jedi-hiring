{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/resolution-request-v1.schema.json",
  "title": "JEDI Atlas recovery projection resolution request",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "resolver_kind_code", "request_code", "operation_id", "operation_nonce", "idempotency_key_sha256", "sender", "recipient", "runtime_generation", "subject", "requested_at", "expires_at", "knowledge_boundary", "prior_accepted_source_heads", "source_contract_fingerprints", "input_response_record_digests", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-recovery-projection-resolution-request" },
    "format_version": { "const": "1.0.0" },
    "resolver_kind_code": { "enum": ["d901_control_access", "d920_accepted_evidence", "d930_custody", "d940_composite_snapshot"] },
    "request_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/operationNonce" },
    "idempotency_key_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" },
    "sender": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/serviceIdentity" },
    "recipient": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/serviceIdentity" },
    "runtime_generation": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/runtimeGeneration" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/subject" },
    "requested_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/timestamp" },
    "knowledge_boundary": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/knowledgeBoundary" },
    "prior_accepted_source_heads": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sourceHead" } },
    "source_contract_fingerprints": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" } },
    "input_response_record_digests": { "type": "array", "maxItems": 3, "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" } },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "resolver_kind_code": { "const": "d940_composite_snapshot" } }, "required": ["resolver_kind_code"] },
      "then": { "properties": { "input_response_record_digests": { "minItems": 3, "maxItems": 3 } } },
      "else": { "properties": { "input_response_record_digests": { "maxItems": 0 } } }
    }
  ]
}
