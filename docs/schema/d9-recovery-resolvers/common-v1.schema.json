{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json",
  "title": "JEDI Atlas recovery-projection resolver shared definitions",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonnegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "stableCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
    "operationNonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_kind_code", "subject_identity_sha256"],
      "properties": {
        "subject_kind_code": { "enum": ["artifact", "custody_copy", "evidence_bundle", "processing_output", "candidate_occurrence", "authority_draft"] },
        "subject_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_profile_record_digest_sha256", "identity_bindings_record_digest_sha256", "binding_generation"],
      "properties": {
        "runtime_profile_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "identity_bindings_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "binding_generation": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "serviceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_role_code", "binding_code", "endpoint_code", "executable_build_sha256"],
      "properties": {
        "runtime_role_code": { "enum": ["trusted_launcher", "independent_verifier", "journal_broker"] },
        "binding_code": { "$ref": "#/$defs/stableCode" },
        "endpoint_code": { "enum": ["ipc.launcher", "ipc.verifier", "ipc.journal"] },
        "executable_build_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "knowledgeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_at", "known_through_receipt_sequence", "trusted_clock_role_code"],
      "properties": {
        "known_at": { "$ref": "#/$defs/timestamp" },
        "known_through_receipt_sequence": { "$ref": "#/$defs/positiveInteger" },
        "trusted_clock_role_code": { "const": "trusted_launcher" }
      }
    },
    "sourceHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_namespace_code", "source_contract_fingerprint_sha256", "head_sequence", "head_digest_sha256", "head_persisted_at", "inventory_digest_sha256"],
      "properties": {
        "source_namespace_code": { "enum": ["d901.control-state.v1", "d901.capability-state.v1", "d920.accepted-evidence.v1", "d930.custody-journal.v1", "d930.primary-receipts.v1", "d940.global.control-journal.v1"] },
        "source_contract_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "head_sequence": { "$ref": "#/$defs/positiveInteger" },
        "head_digest_sha256": { "$ref": "#/$defs/sha256" },
        "head_persisted_at": { "$ref": "#/$defs/timestamp" },
        "inventory_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_namespace_code", "before", "after", "observed_before_at", "observed_after_at", "stability_code"],
      "properties": {
        "source_namespace_code": { "enum": ["d901.control-state.v1", "d901.capability-state.v1", "d920.accepted-evidence.v1", "d930.custody-journal.v1", "d930.primary-receipts.v1", "d940.global.control-journal.v1"] },
        "before": { "oneOf": [{ "$ref": "#/$defs/sourceHead" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/sourceHead" }, { "type": "null" }] },
        "observed_before_at": { "$ref": "#/$defs/timestamp" },
        "observed_after_at": { "$ref": "#/$defs/timestamp" },
        "stability_code": { "enum": ["stable", "moved", "unavailable", "ambiguous"] }
      }
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_code", "operation_id", "operation_nonce", "idempotency_key_sha256", "sender", "recipient", "runtime_generation", "subject", "requested_at", "expires_at", "knowledge_boundary", "prior_accepted_source_heads", "source_contract_fingerprints", "record_digest_sha256"],
      "properties": {
        "request_code": { "$ref": "#/$defs/stableCode" },
        "operation_id": { "$ref": "#/$defs/stableCode" },
        "operation_nonce": { "$ref": "#/$defs/operationNonce" },
        "idempotency_key_sha256": { "$ref": "#/$defs/sha256" },
        "sender": { "$ref": "#/$defs/serviceIdentity" },
        "recipient": { "$ref": "#/$defs/serviceIdentity" },
        "runtime_generation": { "$ref": "#/$defs/runtimeGeneration" },
        "subject": { "$ref": "#/$defs/subject" },
        "requested_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "knowledge_boundary": { "$ref": "#/$defs/knowledgeBoundary" },
        "prior_accepted_source_heads": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/sourceHead" } },
        "source_contract_fingerprints": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sha256" } },
        "record_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_code", "request_record_digest_sha256", "idempotency_key_sha256", "sender", "recipient", "runtime_generation", "subject", "result_code", "error_code", "observed_at", "responded_at", "append_revalidate_by", "source_observations", "technical_evidence_only", "authority_granted", "record_digest_sha256"],
      "properties": {
        "response_code": { "$ref": "#/$defs/stableCode" },
        "request_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "idempotency_key_sha256": { "$ref": "#/$defs/sha256" },
        "sender": { "$ref": "#/$defs/serviceIdentity" },
        "recipient": { "$ref": "#/$defs/serviceIdentity" },
        "runtime_generation": { "$ref": "#/$defs/runtimeGeneration" },
        "subject": { "$ref": "#/$defs/subject" },
        "result_code": { "enum": ["resolved", "unavailable", "ambiguous", "reconciliation_required"] },
        "error_code": { "type": ["string", "null"], "enum": [null, "source_unavailable", "source_head_moved", "source_head_missing", "source_head_stale", "source_head_future", "source_head_forked", "source_head_gapped", "source_head_rolled_back", "source_substituted", "source_contradictory", "mixed_generation", "mixed_profile", "mixed_subject", "mixed_source_head", "replay_collision", "global_snapshot_unprovable"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "responded_at": { "$ref": "#/$defs/timestamp" },
        "append_revalidate_by": { "$ref": "#/$defs/timestamp" },
        "source_observations": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/sourceObservation" } },
        "technical_evidence_only": { "const": true },
        "authority_granted": { "const": false },
        "record_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
