    "runtime_generation": { "$ref": "common-v1-2.schema.json#/$defs/runtimeGeneration" },
    "subject": { "$ref": "common-v1-2.schema.json#/$defs/subject" },
    "append_request_record_digest_sha256": { "$ref": "common-v1-2.schema.json#/$defs/sha256" },
    "assessment_record_digest_sha256": { "$ref": "common-v1-2.schema.json#/$defs/sha256" },
    "expected_d940_append_position": { "$ref": "common-v1-2.schema.json#/$defs/d940AppendPosition" },
    "pre_append_source_head": { "$ref": "common-v1-2.schema.json#/$defs/sourceHead" },
    "d940_append_receipt_canonical_utf8": { "type": "string", "minLength": 2, "maxLength": 1048576 },
    "d940_append_receipt_record_digest_sha256": { "$ref": "common-v1-2.schema.json#/$defs/sha256" },
    "post_append_source_head": { "$ref": "common-v1-2.schema.json#/$defs/sourceHead" },
