{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-2/common-v1-2.schema.json",
  "title": "D9 recovery resolver checkpoint progression shared definitions",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonnegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "stableCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
    "runtimeGeneration": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/runtimeGeneration" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/subject" },
    "operationNonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/operationNonce" },
    "sourceHead": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sourceHead" },
    "actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-1/common-v1-1.schema.json#/$defs/actor" },
    "checkpointReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_contract_version", "checkpoint_namespace_code", "checkpoint_sequence", "checkpoint_record_digest_sha256", "checkpoint_append_receipt_record_digest_sha256", "source_heads", "source_heads_digest_sha256"],
      "properties": {
        "checkpoint_contract_version": { "enum": ["1.1.0", "1.2.0"] },
        "checkpoint_namespace_code": { "enum": ["d9.resolver.checkpoints.v1.1", "d9.resolver.checkpoint-transitions.v1.2"] },
        "checkpoint_sequence": { "$ref": "#/$defs/positiveInteger" },
        "checkpoint_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "checkpoint_append_receipt_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "source_heads": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/sourceHead" } },
        "source_heads_digest_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "checkpoint_contract_version": { "const": "1.1.0" } }, "required": ["checkpoint_contract_version"] },
          "then": { "properties": { "checkpoint_namespace_code": { "const": "d9.resolver.checkpoints.v1.1" } } },
          "else": { "properties": { "checkpoint_namespace_code": { "const": "d9.resolver.checkpoint-transitions.v1.2" } } }
        }
      ]
    },
    "componentAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolver_kind_code", "component_response_record_digest_sha256", "component_response_durable_record_digest_sha256"],
      "properties": {
        "resolver_kind_code": { "enum": ["d901_control_access", "d920_accepted_evidence", "d930_custody"] },
        "component_response_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "component_response_durable_record_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "d940AppendPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal_namespace_code", "predecessor_receipt_sequence", "predecessor_receipt_record_digest_sha256", "target_receipt_sequence", "target_format", "target_record_code", "target_record_digest_sha256", "target_subject_identity_sha256"],
      "properties": {
        "journal_namespace_code": { "const": "d940.global.control-journal.v1" },
        "predecessor_receipt_sequence": { "$ref": "#/$defs/nonnegativeInteger" },
        "predecessor_receipt_record_digest_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "target_receipt_sequence": { "$ref": "#/$defs/positiveInteger" },
        "target_format": { "const": "jedi-atlas-d940-recovery-assessment" },
        "target_record_code": { "$ref": "#/$defs/stableCode" },
        "target_record_digest_sha256": { "$ref": "#/$defs/sha256" },
        "target_subject_identity_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "predecessor_receipt_sequence": { "const": 0 } }, "required": ["predecessor_receipt_sequence"] },
          "then": { "properties": { "predecessor_receipt_record_digest_sha256": { "type": "null" }, "target_receipt_sequence": { "const": 1 } } },
          "else": { "properties": { "predecessor_receipt_record_digest_sha256": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "progressionJournalHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_code", "sequence", "record_digest_sha256"],
      "properties": {
        "namespace_code": { "enum": ["d9.resolver.progression-intents.v1.2", "d9.resolver.checkpoint-transitions.v1.2"] },
        "sequence": { "$ref": "#/$defs/nonnegativeInteger" },
        "record_digest_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "sequence": { "const": 0 } }, "required": ["sequence"] },
          "then": { "properties": { "record_digest_sha256": { "type": "null" } } },
          "else": { "properties": { "record_digest_sha256": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "d940Delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_namespace_code", "before", "after", "delta_code"],
      "properties": {
        "source_namespace_code": { "const": "d940.global.control-journal.v1" },
        "before": { "$ref": "#/$defs/sourceHead" },
        "after": { "$ref": "#/$defs/sourceHead" },
        "delta_code": { "const": "single_authorized_assessment_append" }
      }
    }
  }
}
