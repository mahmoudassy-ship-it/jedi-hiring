{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-3-0/primary-durability-receipt-v1.schema.json",
  "title": "JEDI Atlas D9.3.0 primary custody durability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "receipt_file_profile_code",
    "hash_algorithm_code",
    "runtime_profile_record_digest_sha256",
    "identity_bindings_record_digest_sha256",
    "d930_operational_profile_record_digest_sha256",
    "semantic",
    "semantic_payload_sha256",
    "persistence_request_record_digest_sha256",
    "persisted_by_binding_code",
    "persisted_at"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-primary-durability-receipt" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "receipt_file_profile_code": { "const": "canonical_json_utf8_no_lf_v1" },
    "hash_algorithm_code": { "const": "sha256" },
    "runtime_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "identity_bindings_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "d930_operational_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "semantic": { "$ref": "https://jedi-hiring.invalid/schema/d9-3-0/common-v1.schema.json#/$defs/primaryReceiptSemantic" },
    "semantic_payload_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "persistence_request_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "persisted_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" }
