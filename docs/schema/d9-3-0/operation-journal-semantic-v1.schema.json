    "error_code": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-3-0/common-v1.schema.json#/$defs/extendedErrorCode" }, { "type": "null" }] },
    "retryability_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/retryabilityCode" },
    "recovery_class_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/recoveryClassCode" },
    "rows_delta": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/rowCounts" }, { "type": "null" }] },
    "objects_delta": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/objectCounts" }, { "type": "null" }] },
    "object_disposition_code": { "enum": ["none", "temporary", "durable_referenced", "durable_orphan", "candidate_only", "backup_only"] },
    "candidate_file_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
