    "artifact_backup_receipt": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-3-0/common-v1.schema.json#/$defs/artifactBackupReceiptReference" }, { "type": "null" }] },
    "prior_database_backup_receipt": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-3-0/common-v1.schema.json#/$defs/priorDatabaseBackupReceiptReference" }, { "type": "null" }] },
    "final_backup_receipt": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-3-0/common-v1.schema.json#/$defs/finalBackupReceiptReference" }, { "type": "null" }] },
    "recovery": { "oneOf": [{ "$ref": "#/$defs/recoveryPayload" }, { "type": "null" }] },
    "event_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
