    "authorization_bundle_seal_record_digest_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "prepromotion_authorization_record_digest_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "bundle": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/bundleReference" }, { "type": "null" }] },
    "target_logical_state": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/logicalStateReference" },
    "observed_logical_state": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/logicalStateReference" }, { "type": "null" }] },
