      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind_code", "recovery_chain_code", "recovery_attempt_sequence", "prior_attempt_terminal_record_digest_sha256", "subject_operation_id", "subject_operation_nonce", "subject_bundle", "subject_artifact", "subject_copy_code", "subject_backend_code", "subject_backend_reference", "source_terminal_journal_code", "source_terminal_journal_sequence", "source_terminal_journal_head_record_digest_sha256", "source_terminal_journal_persisted_at", "source_terminal_error_code", "knowledge_snapshot", "observation", "decision_rule_code", "classification_code", "next_step_code", "classification_outcome_code", "blocking_reason_codes", "action_execution_code"],
      "properties": {
        "record_kind_code": { "const": "classification_only_recovery_assessment" },
        "recovery_chain_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "recovery_attempt_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "prior_attempt_terminal_record_digest_sha256": { "$ref": "#/$defs/nullableSha" },
        "subject_operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "subject_operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
        "subject_bundle": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/bundleReference" }, { "type": "null" }] },
        "subject_artifact": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/artifactIdentity" }, { "type": "null" }] },
        "subject_copy_code": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" }, { "type": "null" }] },
        "subject_backend_code": { "oneOf": [{ "const": "pilot_local_cas_v1" }, { "type": "null" }] },
        "subject_backend_reference": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/safeBackendReference" }, { "type": "null" }] },
        "source_terminal_journal_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "source_terminal_journal_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "source_terminal_journal_head_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "source_terminal_journal_persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "source_terminal_error_code": { "enum": ["PROMOTION_STATE_AMBIGUOUS", "FINAL_BACKUP_FAILED", "JOURNAL_COMPLETION_WRITE_FAILED"] },
        "knowledge_snapshot": { "$ref": "#/$defs/knowledgeSnapshot" },
        "observation": { "$ref": "#/$defs/observation" },
        "decision_rule_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "classification_code": { "enum": ["before_prepare_no_effect", "temporary_only", "finalization_ambiguous", "durable_unattested", "receipt_durable_response_unresolved", "durable_unlinked", "artifact_backup_pending", "candidate_only", "promotion_ambiguous", "promoted_completion_pending", "canonical_referenced", "referenced_unverifiable", "active_operation", "held_or_referenced", "ambiguous"] },
        "next_step_code": { "enum": ["none", "retain_and_hold", "new_exact_operation_required", "wait_for_d9_4", "wait_for_d9_5", "post_promotion_completion_authority_required"] },
        "classification_outcome_code": { "enum": ["classified_no_effect", "classified_retained", "classified_hold", "classified_new_operation_required", "classified_waiting_dependency", "classified_authority_required"] },
        "blocking_reason_codes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "enum": ["active_operation", "lock_not_current", "accepted_reference", "candidate_reference", "journal_reference", "backup_reference", "hold_present", "bytes_unavailable", "bytes_mismatch", "incomplete_inventory", "state_ambiguous", "response_unresolvable", "d9_4_required", "d9_5_required", "authority_not_defined", "scope_not_authorized"] } },
        "action_execution_code": { "const": "none_classification_only" }
      }
