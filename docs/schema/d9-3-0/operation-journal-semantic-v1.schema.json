        "recovery_lock_owner_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "recovery_lock_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "recovery_lock_acquired_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "recovery_lock_expires_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "scan_started_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "scan_completed_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "snapshot_completeness_code": { "enum": ["complete", "incomplete"] },
        "known_through_journal_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "known_through_journal_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "known_through_journal_head_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "known_through_journal_head_persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "operation_control_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "capability_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "primary_receipt_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "custody_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "candidate_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "canonical_state_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "reference_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "hold_inventory": { "$ref": "#/$defs/inventoryCommitment" },
        "backup_inventory": { "$ref": "#/$defs/backupInventoryCommitment" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_state_code", "lock_state_code", "temporary_state_code", "final_object_state_code", "primary_receipt_state_code", "adapter_response_state_code", "journal_link_state_code", "artifact_backup_state_code", "candidate_state_code", "prior_backup_state_code", "promotion_state_code", "canonical_state_code", "final_backup_state_code", "completion_state_code", "reference_scan_code", "hold_scan_code", "bytes_state_code"],
      "properties": {
        "operation_state_code": { "enum": ["not_started", "active", "terminal", "unknown"] },
        "lock_state_code": { "enum": ["held_by_recovery_operation", "held_by_other", "absent", "stale", "unknown"] },
        "temporary_state_code": { "enum": ["absent", "partial", "verified", "unknown"] },
        "final_object_state_code": { "enum": ["absent", "exact", "mismatch", "unknown"] },
        "primary_receipt_state_code": { "enum": ["absent", "exact", "mismatch", "unknown"] },
        "adapter_response_state_code": { "enum": ["absent", "exact_resolvable", "unresolvable", "mismatch", "unknown"] },
        "journal_link_state_code": { "enum": ["absent", "exact", "mismatch", "unknown"] },
        "artifact_backup_state_code": { "enum": ["not_applicable", "unavailable_d9_5", "reference_exact", "reference_missing", "unknown"] },
        "candidate_state_code": { "enum": ["absent", "committed", "sealed", "unknown"] },
        "prior_backup_state_code": { "enum": ["not_applicable", "unavailable_d9_5", "reference_exact", "reference_missing", "unknown"] },
        "promotion_state_code": { "enum": ["not_started", "rename_unknown", "target_verified", "unknown"] },
        "canonical_state_code": { "enum": ["prior_exact", "target_exact", "other", "unknown"] },
        "final_backup_state_code": { "enum": ["not_applicable", "unavailable_d9_5", "reference_exact", "reference_missing", "unknown"] },
        "completion_state_code": { "enum": ["absent", "exact", "mismatch", "unknown"] },
        "reference_scan_code": { "enum": ["complete_none", "complete_present", "incomplete"] },
        "hold_scan_code": { "enum": ["complete_none", "complete_present", "incomplete"] },
        "bytes_state_code": { "enum": ["not_applicable", "available_exact", "unavailable", "mismatch", "unknown"] }
      }
