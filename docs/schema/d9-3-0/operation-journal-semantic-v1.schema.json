  "$defs": {
    "nullableSha": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "inventoryCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_code", "head_digest_sha256"],
      "properties": {
        "state_code": { "enum": ["complete_empty", "complete_nonempty", "unavailable"] },
        "head_digest_sha256": { "$ref": "#/$defs/nullableSha" }
      }
    },
    "backupInventoryCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_code", "head_digest_sha256"],
      "properties": {
        "state_code": { "enum": ["complete_empty", "complete_nonempty", "unavailable_d9_5", "unavailable"] },
        "head_digest_sha256": { "$ref": "#/$defs/nullableSha" }
      }
    },
    "knowledgeSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_operation_id", "subject_operation_nonce", "recovery_operation_id", "recovery_operation_nonce", "recovery_lock_storage_slot_code", "recovery_lock_owner_binding_code", "recovery_lock_projection_sha256", "recovery_lock_acquired_at", "recovery_lock_expires_at", "scan_started_at", "scan_completed_at", "snapshot_completeness_code", "known_through_journal_code", "known_through_journal_sequence", "known_through_journal_head_record_digest_sha256", "known_through_journal_head_persisted_at", "operation_control_inventory", "capability_inventory", "primary_receipt_inventory", "custody_inventory", "candidate_inventory", "canonical_state_inventory", "reference_inventory", "hold_inventory", "backup_inventory"],
      "properties": {
        "subject_operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "subject_operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
        "recovery_operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "recovery_operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
