{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-3-0/operation-journal-event-v2.schema.json",
  "title": "JEDI Atlas D9.3.0 broker-persisted operation-journal event",
  "type": "object",
