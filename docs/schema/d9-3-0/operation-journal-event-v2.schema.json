  "required": ["format", "format_version", "record_code", "journal_code", "event_sequence", "previous_event_record_digest_sha256", "semantic_assertion", "semantic_assertion_record_digest_sha256", "append_request_record_digest_sha256", "persisted_by_binding_code", "persisted_at", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-operation-journal-event" },
    "format_version": { "const": "2.0.0" },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "journal_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "event_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
    "previous_event_record_digest_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "semantic_assertion": { "$ref": "https://jedi-hiring.invalid/schema/d9-3-0/operation-journal-semantic-v1.schema.json" },
    "semantic_assertion_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "append_request_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "persisted_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
