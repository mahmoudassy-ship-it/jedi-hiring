    "variant_selection_rule": "exactly_one_selector_for_each_closed_contract_discriminator_value",
    "unmapped_property_rule": "reject",
    "nested_pattern_grammar": "/**/<literal> or /**/*<suffix>; terminal property names only; JSON Pointer escaping applies",
    "nested_pattern_precedence": "exact_literal_before_suffix; equal_specificity_overlap_rejected"
  },
