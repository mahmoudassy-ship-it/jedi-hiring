{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-3-0/integrity-access-lifecycle-record-v1.schema.json",
  "title": "JEDI Atlas D9.3.0 secret-free integrity access lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_kind_code",
    "record_code",
    "operation_id",
    "operation_nonce",
    "bundle",
    "artifact",
    "copy_code",
    "backend_code",
    "backend_reference",
    "purpose_code",
    "runtime_profile_record_digest_sha256",
    "identity_bindings_record_digest_sha256",
    "d930_operational_profile_record_digest_sha256",
    "open_custody_request_record_digest_sha256",
    "open_custody_response_record_digest_sha256",
    "sealed_capability_record_digest_sha256",
    "sealed_capability_consumed_transition_digest_sha256",
    "producer_binding_code",
    "sender_binding_code",
    "receiver_binding_code",
    "verifier_binding_code",
    "verifier_executable_sha256",
    "receiver_process",
    "descriptor_delivery_record_digest_sha256",
    "verifier_result_record_digest_sha256",
    "transport_code",
    "descriptor_role_code",
    "access_code",
    "file_type_code",
    "peer_credentials_verified",
    "pidfd_supervision_active",
    "verification_outcome_code",
    "recomputed_artifact",
    "sender_close_state_code",
    "sender_closed_at",
    "receiver_termination_state_code",
    "receiver_terminated_at",
    "termination_disposition_code",
    "receiver_descriptor_closed_by_termination",
    "lifecycle_outcome_code",
    "event_at",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-integrity-access-lifecycle-record" },
    "format_version": { "const": "1.0.0" },
    "record_kind_code": { "enum": ["descriptor_delivery", "verifier_result", "access_closed_and_receiver_terminated"] },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
    "bundle": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/bundleReference" },
    "artifact": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/artifactIdentity" },
    "copy_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "backend_code": { "const": "pilot_local_cas_v1" },
    "backend_reference": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/safeBackendReference" },
    "purpose_code": { "const": "integrity" },
    "runtime_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "identity_bindings_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "d930_operational_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "open_custody_request_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "open_custody_response_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "sealed_capability_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "sealed_capability_consumed_transition_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "producer_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "sender_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "receiver_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "verifier_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "verifier_executable_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "receiver_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_instance_code", "pid", "uid", "gid", "start_time_ticks", "executable_device", "executable_inode"],
      "properties": {
        "process_instance_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "pid": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "uid": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "gid": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "start_time_ticks": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "executable_device": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "executable_inode": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" }
      }
    },
    "descriptor_delivery_record_digest_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "verifier_result_record_digest_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "transport_code": { "oneOf": [{ "const": "launcher_supervised_scm_rights" }, { "type": "null" }] },
    "descriptor_role_code": { "oneOf": [{ "const": "custody_source" }, { "type": "null" }] },
    "access_code": { "oneOf": [{ "const": "read_only" }, { "type": "null" }] },
    "file_type_code": { "oneOf": [{ "const": "regular_file" }, { "type": "null" }] },
    "peer_credentials_verified": { "oneOf": [{ "const": true }, { "type": "null" }] },
    "pidfd_supervision_active": { "oneOf": [{ "const": true }, { "type": "null" }] },
    "verification_outcome_code": { "oneOf": [{ "enum": ["passed", "identity_mismatch", "read_failed", "timeout"] }, { "type": "null" }] },
    "recomputed_artifact": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/artifactIdentity" }, { "type": "null" }] },
    "sender_close_state_code": { "oneOf": [{ "enum": ["confirmed", "unknown"] }, { "type": "null" }] },
    "sender_closed_at": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" }, { "type": "null" }] },
    "receiver_termination_state_code": { "oneOf": [{ "enum": ["confirmed", "unknown"] }, { "type": "null" }] },
    "receiver_terminated_at": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" }, { "type": "null" }] },
    "termination_disposition_code": { "oneOf": [{ "enum": ["clean_exit_reaped", "signaled_reaped", "forced_kill_reaped", "unknown"] }, { "type": "null" }] },
    "receiver_descriptor_closed_by_termination": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
    "lifecycle_outcome_code": { "oneOf": [{ "enum": ["completed_verified", "recovery_required"] }, { "type": "null" }] },
    "event_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_kind_code": { "const": "descriptor_delivery" } }, "required": ["record_kind_code"] },
      "then": { "properties": {
        "transport_code": { "const": "launcher_supervised_scm_rights" },
        "descriptor_role_code": { "const": "custody_source" },
        "access_code": { "const": "read_only" },
        "file_type_code": { "const": "regular_file" },
        "peer_credentials_verified": { "const": true },
        "pidfd_supervision_active": { "const": true },
        "descriptor_delivery_record_digest_sha256": { "type": "null" },
        "verifier_result_record_digest_sha256": { "type": "null" },
        "verification_outcome_code": { "type": "null" },
        "recomputed_artifact": { "type": "null" },
        "sender_close_state_code": { "type": "null" },
        "sender_closed_at": { "type": "null" },
        "receiver_termination_state_code": { "type": "null" },
        "receiver_terminated_at": { "type": "null" },
        "termination_disposition_code": { "type": "null" },
        "receiver_descriptor_closed_by_termination": { "type": "null" },
        "lifecycle_outcome_code": { "type": "null" }
      } }
    },
    {
      "if": { "properties": { "record_kind_code": { "const": "verifier_result" } }, "required": ["record_kind_code"] },
      "then": { "properties": {
        "descriptor_delivery_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "verifier_result_record_digest_sha256": { "type": "null" },
        "transport_code": { "type": "null" },
        "descriptor_role_code": { "type": "null" },
        "access_code": { "type": "null" },
        "file_type_code": { "type": "null" },
        "peer_credentials_verified": { "type": "null" },
        "pidfd_supervision_active": { "type": "null" },
        "verification_outcome_code": { "enum": ["passed", "identity_mismatch", "read_failed", "timeout"] },
        "sender_close_state_code": { "type": "null" },
        "sender_closed_at": { "type": "null" },
        "receiver_termination_state_code": { "type": "null" },
        "receiver_terminated_at": { "type": "null" },
        "termination_disposition_code": { "type": "null" },
        "receiver_descriptor_closed_by_termination": { "type": "null" },
        "lifecycle_outcome_code": { "type": "null" }
      } }
    },
    {
      "if": { "properties": { "record_kind_code": { "const": "access_closed_and_receiver_terminated" } }, "required": ["record_kind_code"] },
      "then": { "properties": {
        "descriptor_delivery_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "verifier_result_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "transport_code": { "type": "null" },
        "descriptor_role_code": { "type": "null" },
        "access_code": { "type": "null" },
        "file_type_code": { "type": "null" },
        "peer_credentials_verified": { "type": "null" },
        "pidfd_supervision_active": { "type": "null" },
        "verification_outcome_code": { "type": "null" },
        "recomputed_artifact": { "type": "null" },
        "sender_close_state_code": { "enum": ["confirmed", "unknown"] },
        "sender_closed_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "receiver_termination_state_code": { "enum": ["confirmed", "unknown"] },
        "receiver_terminated_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "termination_disposition_code": { "enum": ["clean_exit_reaped", "signaled_reaped", "forced_kill_reaped", "unknown"] },
        "receiver_descriptor_closed_by_termination": { "type": "boolean" },
        "lifecycle_outcome_code": { "enum": ["completed_verified", "recovery_required"] }
      } }
    },
    {
      "if": { "properties": { "record_kind_code": { "const": "verifier_result" }, "verification_outcome_code": { "const": "passed" } }, "required": ["record_kind_code", "verification_outcome_code"] },
      "then": { "properties": { "recomputed_artifact": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/artifactIdentity" } } }
    },
    {
      "if": { "properties": { "record_kind_code": { "const": "verifier_result" }, "verification_outcome_code": { "enum": ["identity_mismatch", "read_failed", "timeout"] } }, "required": ["record_kind_code", "verification_outcome_code"] },
      "then": { "properties": { "recomputed_artifact": { "type": "null" } } }
    }
  ]
}
