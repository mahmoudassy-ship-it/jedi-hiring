{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-0/clearance-record-v1.schema.json",
  "title": "JEDI Atlas D9.0 per-artifact clearance decision and transition",
  "oneOf": [
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/revocationTransition" },
    { "$ref": "#/$defs/supersessionTransition" },
    { "$ref": "#/$defs/prepromotionAuthorization" }
  ],
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "record_kind_code",
        "record_code",
        "clearance_code",
        "artifact",
        "decision_code",
        "capture_context_code",
        "supporting_record_code",
        "supporting_record_sha256",
        "runtime_profile_record_digest_sha256",
        "identity_bindings_record_digest_sha256",
        "clearance_operational_profile_sha256",
        "clearance_scope_sha256",
        "retention_scope_code",
        "redistribution_scope_code",
        "derivative_use_code",
        "contains_personal_data",
        "contains_credentials",
        "sensitivity_code",
        "git_permanence_acknowledged",
        "repository_declarations",
        "scanner_results",
        "decided_by_binding_code",
        "independently_checked_by_binding_code",
        "decided_at",
        "not_before",
        "expires_at",
        "recorded_at",
        "conditions",
        "limitations",
        "record_digest_sha256"
      ],
      "properties": {
        "format": { "const": "jedi-atlas-clearance-record" },
        "format_version": { "const": "1.0.0" },
        "record_kind_code": { "const": "clearance_decision" },
        "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "clearance_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "artifact": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/artifactIdentity" },
        "decision_code": { "enum": ["restricted_store_only", "repository_eligible", "do_not_retain"] },
        "capture_context_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "supporting_record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "supporting_record_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "runtime_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "identity_bindings_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "clearance_operational_profile_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "clearance_scope_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "retention_scope_code": { "enum": ["none", "pilot_only", "repository_history"] },
        "redistribution_scope_code": { "enum": ["none", "repository"] },
        "derivative_use_code": { "enum": ["none", "internal_only", "repository_allowed"] },
        "contains_personal_data": { "const": false },
        "contains_credentials": { "const": false },
        "sensitivity_code": { "enum": ["restricted", "repository_safe"] },
        "git_permanence_acknowledged": { "type": "boolean" },
        "repository_declarations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["redistribution_eligible", "no_sensitive_data", "size_eligible", "permanent_history_acknowledged"],
          "properties": {
            "redistribution_eligible": { "type": "boolean" },
            "no_sensitive_data": { "type": "boolean" },
            "size_eligible": { "type": "boolean" },
            "permanent_history_acknowledged": { "type": "boolean" }
          }
        },
        "scanner_results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/scannerResultReference" }
        },
        "decided_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "independently_checked_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "decided_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "not_before": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "expires_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "recorded_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/safeMessage" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/safeMessage" }
        },
        "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
      }
    },
    "revocationTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "record_kind_code",
        "record_code",
        "clearance_code",
        "decision_record_digest_sha256",
        "previous_transition_record_digest_sha256",
        "transition_sequence",
        "state_code",
        "replacement_clearance_record_digest_sha256",
        "recorded_by_binding_code",
        "occurred_at",
        "reason_code",
        "record_digest_sha256"
      ],
      "properties": {
        "format": { "const": "jedi-atlas-clearance-record" },
        "format_version": { "const": "1.0.0" },
        "record_kind_code": { "const": "clearance_transition" },
        "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "clearance_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "decision_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "previous_transition_record_digest_sha256": { "type": "null" },
        "transition_sequence": { "const": 1 },
        "state_code": { "const": "revoked" },
        "replacement_clearance_record_digest_sha256": { "type": "null" },
        "recorded_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "occurred_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "reason_code": { "enum": ["policy_changed", "new_information", "operator_withdrawal"] },
        "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
      }
    },
    "supersessionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "record_kind_code",
        "record_code",
        "clearance_code",
        "decision_record_digest_sha256",
        "previous_transition_record_digest_sha256",
        "transition_sequence",
        "state_code",
        "replacement_clearance_record_digest_sha256",
        "recorded_by_binding_code",
        "occurred_at",
        "reason_code",
        "record_digest_sha256"
      ],
      "properties": {
        "format": { "const": "jedi-atlas-clearance-record" },
        "format_version": { "const": "1.0.0" },
        "record_kind_code": { "const": "clearance_transition" },
        "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "clearance_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "decision_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "previous_transition_record_digest_sha256": { "type": "null" },
        "transition_sequence": { "const": 1 },
        "state_code": { "const": "superseded" },
        "replacement_clearance_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "recorded_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "occurred_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "reason_code": { "enum": ["policy_changed", "new_information", "record_corrected"] },
        "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
      }
    },
    "prepromotionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "record_kind_code",
        "record_code",
        "operation_id",
        "operation_nonce",
        "runtime_profile_record_digest_sha256",
        "identity_bindings_record_digest_sha256",
        "bundle_seal_record_digest_sha256",
        "collector_handoff_record_digest_sha256",
        "candidate_file_seal_record_digest_sha256",
        "clearance_decision_record_digest_sha256",
        "source_clearance_scope_sha256",
        "artifact",
        "custody_leaf_projection_sha256",
        "known_through_bundle_sequence",
        "authorized_by_binding_code",
        "persisted_by_binding_code",
        "evaluated_at",
        "persisted_at",
        "expires_at",
        "record_digest_sha256"
      ],
      "properties": {
        "format": { "const": "jedi-atlas-clearance-record" },
        "format_version": { "const": "1.0.0" },
        "record_kind_code": { "const": "prepromotion_authorization" },
        "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
        "runtime_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "identity_bindings_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "bundle_seal_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "collector_handoff_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "candidate_file_seal_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "clearance_decision_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "source_clearance_scope_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "artifact": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/artifactIdentity" },
        "custody_leaf_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "known_through_bundle_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "authorized_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "persisted_by_binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        "evaluated_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "expires_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
      }
    }
  }
}
