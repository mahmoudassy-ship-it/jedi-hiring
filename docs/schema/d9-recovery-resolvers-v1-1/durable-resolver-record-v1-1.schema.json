    "attestation_record_digest_sha256": { "oneOf": [{ "$ref": "common-v1-1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "payload_producer": { "$ref": "common-v1-1.schema.json#/$defs/actor" }, "semantic_actor": { "$ref": "common-v1-1.schema.json#/$defs/actor" }, "persistence_actor": { "$ref": "common-v1-1.schema.json#/$defs/actor" },
    "accepted_at": { "$ref": "common-v1-1.schema.json#/$defs/timestamp" }, "persisted_at": { "$ref": "common-v1-1.schema.json#/$defs/timestamp" },
    "checkpoint_sequence": { "$ref": "common-v1-1.schema.json#/$defs/positiveInteger" }, "checkpoint_record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" },
    "technical_evidence_only": { "const": true }, "authority_granted": { "const": false }, "record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" }
  }
