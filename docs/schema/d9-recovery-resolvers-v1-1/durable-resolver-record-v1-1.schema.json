{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-1/durable-resolver-record-v1-1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "record_code", "record_kind_code", "resolver_kind_code", "sequence", "predecessor_record_digest_sha256", "operation_id", "operation_nonce", "runtime_generation", "subject", "payload_format", "payload_canonical_utf8", "payload_record_digest_sha256", "semantic_verifier_code", "semantic_verifier_sha256", "request_record_digest_sha256", "response_record_digest_sha256", "attestation_record_digest_sha256", "payload_producer", "semantic_actor", "persistence_actor", "accepted_at", "persisted_at", "checkpoint_sequence", "checkpoint_record_digest_sha256", "technical_evidence_only", "authority_granted", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-recovery-resolver-durable-record" }, "format_version": { "const": "1.1.0" },
    "record_code": { "$ref": "common-v1-1.schema.json#/$defs/stableCode" },
