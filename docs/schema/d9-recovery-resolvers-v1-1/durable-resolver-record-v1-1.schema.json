    "operation_id": { "$ref": "common-v1-1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "common-v1-1.schema.json#/$defs/operationNonce" },
    "runtime_generation": { "$ref": "common-v1-1.schema.json#/$defs/runtimeGeneration" },
    "subject": { "$ref": "common-v1-1.schema.json#/$defs/subject" },
    "payload_format": { "enum": ["jedi-atlas-recovery-projection-resolution-request", "jedi-atlas-recovery-projection-resolution-response", "jedi-atlas-recovery-projection-append-revalidation-attestation"] },
    "payload_canonical_utf8": { "type": "string", "minLength": 2, "maxLength": 1048576 },
    "payload_record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" },
    "semantic_verifier_code": { "const": "d9_recovery_resolvers_v1_0_full_semantics" },
