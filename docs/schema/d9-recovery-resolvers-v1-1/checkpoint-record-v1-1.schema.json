{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-1/checkpoint-record-v1-1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "checkpoint_code", "checkpoint_kind_code", "sequence", "predecessor_record_digest_sha256", "operation_id", "operation_nonce", "runtime_generation", "semantic_actor", "persistence_actor", "observed_at", "persisted_at", "source_heads", "composite_response_record_digest_sha256", "append_attestation_record_digest_sha256", "bootstrap_permit_record_digest_sha256", "technical_evidence_only", "authority_granted", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-recovery-resolver-checkpoint-record" },
    "format_version": { "const": "1.1.0" },
    "checkpoint_code": { "$ref": "common-v1-1.schema.json#/$defs/stableCode" },
    "checkpoint_kind_code": { "enum": ["bootstrap", "advance"] },
    "sequence": { "$ref": "common-v1-1.schema.json#/$defs/positiveInteger" },
    "predecessor_record_digest_sha256": { "oneOf": [{ "$ref": "common-v1-1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "operation_id": { "$ref": "common-v1-1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "common-v1-1.schema.json#/$defs/operationNonce" },
    "runtime_generation": { "$ref": "common-v1-1.schema.json#/$defs/runtimeGeneration" },
    "semantic_actor": { "$ref": "common-v1-1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "common-v1-1.schema.json#/$defs/actor" },
    "observed_at": { "$ref": "common-v1-1.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "common-v1-1.schema.json#/$defs/timestamp" },
    "source_heads": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "common-v1-1.schema.json#/$defs/sourceHead" } },
    "composite_response_record_digest_sha256": { "oneOf": [{ "$ref": "common-v1-1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "append_attestation_record_digest_sha256": { "oneOf": [{ "$ref": "common-v1-1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "bootstrap_permit_record_digest_sha256": { "oneOf": [{ "$ref": "common-v1-1.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "technical_evidence_only": { "const": true }, "authority_granted": { "const": false },
    "record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "checkpoint_kind_code": { "const": "bootstrap" } }, "required": ["checkpoint_kind_code"] }, "then": { "properties": { "sequence": { "const": 1 }, "predecessor_record_digest_sha256": { "type": "null" }, "composite_response_record_digest_sha256": { "type": "null" }, "append_attestation_record_digest_sha256": { "type": "null" }, "bootstrap_permit_record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" } } }, "else": { "properties": { "sequence": { "minimum": 2 }, "predecessor_record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" }, "composite_response_record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" }, "append_attestation_record_digest_sha256": { "$ref": "common-v1-1.schema.json#/$defs/sha256" }, "bootstrap_permit_record_digest_sha256": { "type": "null" } } } }
  ]
}
