{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-1/common-v1-1.schema.json",
  "title": "D9 recovery resolver durability extension shared definitions",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "stableCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_role_code", "binding_code", "endpoint_code", "executable_build_sha256", "binding_generation"],
      "properties": {
        "runtime_role_code": { "enum": ["trusted_launcher", "independent_verifier", "journal_broker"] },
        "binding_code": { "$ref": "#/$defs/stableCode" },
        "endpoint_code": { "enum": ["ipc.launcher", "ipc.verifier", "ipc.journal"] },
        "executable_build_sha256": { "$ref": "#/$defs/sha256" },
        "binding_generation": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "runtimeGeneration": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/runtimeGeneration" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/subject" },
    "operationNonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/operationNonce" },
    "sourceHead": { "$ref": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers/common-v1.schema.json#/$defs/sourceHead" },
    "journalHead": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace_code", "sequence", "record_digest_sha256"],
      "properties": {
        "namespace_code": { "enum": ["d9.resolver.records.v1.1", "d9.resolver.checkpoints.v1.1", "d9.resolver.assessment-links.v1.1"] },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "record_digest_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "sequence": { "const": 0 } }, "required": ["sequence"] }, "then": { "properties": { "record_digest_sha256": { "type": "null" } } }, "else": { "properties": { "record_digest_sha256": { "$ref": "#/$defs/sha256" } } } }
      ]
    }
  }
}
