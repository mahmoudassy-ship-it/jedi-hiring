{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-4-0/authority-identity-extension-v1.schema.json",
  "title": "JEDI Atlas D9.4.0 one-binding synthetic roster-adopter identity extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "extension_generation",
    "identity_bindings_record_digest_sha256",
    "binding_set_code",
    "binding_generation",
    "issued_at",
    "expires_at",
    "bindings",
    "activation_state_code",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-d940-authority-identity-extension" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "extension_generation": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
    "identity_bindings_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "binding_set_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "binding_generation": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
    "issued_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_code", "extension_role_code", "principal_kind_code", "principal_code", "subject_kind_code", "unix_uid", "valid_from", "valid_until"],
        "properties": {
          "binding_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
          "extension_role_code": { "const": "d940_roster_adopter" },
          "principal_kind_code": { "const": "human" },
          "principal_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/principalCode" },
          "subject_kind_code": { "const": "unix_uid" },
          "unix_uid": { "type": "integer", "minimum": 1000, "maximum": 4294967294 },
          "valid_from": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
          "valid_until": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" }
        }
      }
    },
    "activation_state_code": { "const": "design_only_unactivated" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  }
}
