{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-4-0/deletion-execution-record-v1.schema.json",
  "title": "JEDI Atlas D9.4.0 primary-copy deletion execution and observation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_kind_code",
    "record_code",
    "operation_id",
    "operation_nonce",
    "subject",
    "chain",
    "deletion_authorization_record_digest_sha256",
    "tombstone_record_digest_sha256",
    "authorization_scope_sha256",
    "d930_operational_profile_record_digest_sha256",
    "d930_primary_durability_receipt_sha256",
    "safety_snapshot",
    "access_shutdown_state_code",
    "inventory",
    "execution",
    "semantic_actor",
    "persistence_actor",
    "knowledge_boundary",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-deletion-execution-record" },
    "format_version": { "const": "1.0.0" },
    "record_kind_code": {
      "enum": ["execution_started", "inventory_observed", "unlink_attempted", "unlink_failed", "primary_absence_verified", "verification_failed", "reconciliation_required"]
    },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/subject" },
    "chain": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/chain" },
    "deletion_authorization_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "tombstone_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "authorization_scope_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "d930_operational_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "d930_primary_durability_receipt_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "safety_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256",
        "journal_namespace_code",
        "known_through_receipt_sequence",
        "known_through_persisted_at",
        "control_ledger_head_receipt_digest_sha256",
        "control_head_projection_sha256",
        "access_head_projection_sha256",
        "subject_lineage_projection_sha256",
        "custody_leaf_projection_sha256",
        "inventory_snapshot_sha256",
        "active_hold_count",
        "unknown_or_conflicting_control_count"
      ],
      "properties": {
        "snapshot_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "journal_namespace_code": { "const": "d940.global.control-journal.v1" },
        "known_through_receipt_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
        "known_through_persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
        "control_ledger_head_receipt_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "control_head_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "access_head_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "subject_lineage_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "custody_leaf_projection_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "inventory_snapshot_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
        "active_hold_count": { "type": "integer", "minimum": 0, "maximum": 256 },
        "unknown_or_conflicting_control_count": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    },
    "access_shutdown_state_code": { "enum": ["confirmed", "incomplete", "unknown"] },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_primary_names_checked",
        "matching_primary_names",
        "open_descriptors",
        "hard_links",
        "unexpected_replicas",
        "temporary_objects",
        "backup_state_code",
        "inventory_complete",
        "target_file_type_code",
        "target_path_identity_sha256",
        "parent_directory_identity_sha256",
        "target_device",
        "target_inode",
        "parent_directory_device",
        "parent_directory_inode",
        "observed_target_sha256",
        "observed_target_byte_length",
        "observed_target_link_count",
        "prior_target_observation_record_digest_sha256",
        "parent_directory_opened_no_follow",
        "target_opened_no_follow",
        "symlink_observed"
      ],
      "properties": {
        "approved_primary_names_checked": { "type": "integer", "minimum": 0, "maximum": 256 },
        "matching_primary_names": { "type": "integer", "minimum": 0, "maximum": 256 },
        "open_descriptors": { "type": "integer", "minimum": 0, "maximum": 64 },
        "hard_links": { "type": "integer", "minimum": 0, "maximum": 256 },
        "unexpected_replicas": { "type": "integer", "minimum": 0, "maximum": 256 },
        "temporary_objects": { "type": "integer", "minimum": 0, "maximum": 256 },
        "backup_state_code": { "enum": ["not_implemented", "unknown", "present", "absent_unverified", "deletion_pending_d9_5"] },
        "inventory_complete": { "type": "boolean" }
        ,"target_file_type_code": { "enum": ["regular_file", "absent", "unexpected"] }
        ,"target_path_identity_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
        ,"parent_directory_identity_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
        ,"target_device": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" }, { "type": "null" }] }
        ,"target_inode": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" }, { "type": "null" }] }
        ,"parent_directory_device": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" }
        ,"parent_directory_inode": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" }
        ,"observed_target_sha256": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }, { "type": "null" }] }
        ,"observed_target_byte_length": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/nonnegativeSafeInteger" }, { "type": "null" }] }
        ,"observed_target_link_count": { "oneOf": [{ "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" }, { "type": "null" }] }
        ,"prior_target_observation_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/nullableSha256" }
        ,"parent_directory_opened_no_follow": { "type": "boolean" }
        ,"target_opened_no_follow": { "type": "boolean" }
        ,"symlink_observed": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_code",
        "target_name_removed",
        "directory_synced",
        "reopened_target_absent",
        "content_erase_claimed",
        "complete_erasure_claimed",
        "outcome_code"
      ],
      "properties": {
        "method_code": { "enum": ["none", "unlink_primary_name_no_follow", "verify_primary_absence_no_follow"] },
        "target_name_removed": { "type": "boolean" },
        "directory_synced": { "type": "boolean" },
        "reopened_target_absent": { "type": "boolean" },
        "content_erase_claimed": { "const": false },
        "complete_erasure_claimed": { "const": false },
        "outcome_code": { "enum": ["not_attempted", "primary_name_removed", "primary_absence_verified", "failed", "ambiguous"] }
      }
    },
    "semantic_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "knowledge_boundary": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/knowledgeBoundary" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  }
}
