{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-4-0/access-revocation-record-v1.schema.json",
  "title": "JEDI Atlas D9.4.0 capability and descriptor revocation lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_kind_code",
    "record_code",
    "operation_id",
    "operation_nonce",
    "subject",
    "chain",
    "trigger_control_record_digest_sha256",
    "access_target_kind_code",
    "access_target_identity_sha256",
    "capability_record_digest_sha256",
    "capability_leaf_record_digest_sha256",
    "descriptor_lifecycle_record_digest_sha256",
    "receiver_process_instance_code",
    "sender_close_state_code",
    "receiver_termination_state_code",
    "descriptor_close_state_code",
    "termination_disposition_code",
    "semantic_actor",
    "persistence_actor",
    "knowledge_boundary",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-access-revocation-record" },
    "format_version": { "const": "1.0.0" },
    "record_kind_code": {
      "enum": ["capability_revoked", "descriptor_termination_requested", "descriptor_termination_confirmed", "descriptor_termination_failed"]
    },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/subject" },
    "chain": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/chain" },
    "trigger_control_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "access_target_kind_code": { "enum": ["unconsumed_capability", "issued_descriptor"] },
    "access_target_identity_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "capability_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/nullableSha256" },
    "capability_leaf_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/nullableSha256" },
    "descriptor_lifecycle_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/nullableSha256" },
    "receiver_process_instance_code": {
      "oneOf": [
        { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
        { "type": "null" }
      ]
    },
    "sender_close_state_code": { "oneOf": [{ "enum": ["confirmed", "unknown"] }, { "type": "null" }] },
    "receiver_termination_state_code": { "oneOf": [{ "enum": ["confirmed", "unknown"] }, { "type": "null" }] },
    "descriptor_close_state_code": { "oneOf": [{ "enum": ["confirmed", "unknown"] }, { "type": "null" }] },
    "termination_disposition_code": {
      "oneOf": [
        { "enum": ["clean_exit_reaped", "signaled_reaped", "forced_kill_reaped", "unknown"] },
        { "type": "null" }
      ]
    },
    "semantic_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "knowledge_boundary": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/knowledgeBoundary" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  }
}
