{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-4-0/deletion-receipt-v1.schema.json",
  "title": "JEDI Atlas D9.4.0 bounded primary-copy deletion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "operation_id",
    "operation_nonce",
    "subject",
    "deletion_request_record_digest_sha256",
    "deletion_authorization_record_digest_sha256",
    "tombstone_record_digest_sha256",
    "execution_record_digest_sha256",
    "verification_record_digest_sha256",
    "authorization_scope_sha256",
    "d930_operational_profile_record_digest_sha256",
    "d930_primary_durability_receipt_sha256",
    "safety_snapshot_sha256",
    "control_ledger_head_receipt_digest_sha256",
    "executor",
    "independent_verifier",
    "outcome_code",
    "proof_scope_code",
    "remaining_copy_classes",
    "metadata_retention_code",
    "complete_erasure_claimed",
    "backup_erasure_claimed",
    "legal_compliance_claimed",
    "limitations",
    "completed_at",
    "persistence_actor",
    "knowledge_boundary",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-deletion-receipt" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/subject" },
    "deletion_request_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "deletion_authorization_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "tombstone_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "execution_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "verification_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "authorization_scope_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "d930_operational_profile_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "d930_primary_durability_receipt_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "safety_snapshot_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "control_ledger_head_receipt_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "executor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "independent_verifier": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "outcome_code": { "const": "primary_copy_absence_verified" },
    "proof_scope_code": { "const": "approved_primary_namespace_observation_only" },
    "remaining_copy_classes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "enum": ["backup", "derived", "open_descriptor", "replica", "temporary", "unknown"] }
    },
    "metadata_retention_code": { "enum": ["restricted_audit_digest_retained", "restricted_metadata_review_required"] },
    "complete_erasure_claimed": { "const": false },
    "backup_erasure_claimed": { "const": false },
    "legal_compliance_claimed": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "enum": [
          "no_complete_erasure_claim",
          "no_backup_erasure_claim",
          "no_derived_copy_erasure_claim",
          "no_replica_erasure_claim",
          "no_open_descriptor_erasure_claim",
          "no_storage_medium_overwrite_claim",
          "no_legal_compliance_claim",
          "compromised_kernel_or_root_out_of_scope",
          "observation_is_time_bounded"
        ]
      }
    },
    "completed_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "persistence_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "knowledge_boundary": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/knowledgeBoundary" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  }
}
