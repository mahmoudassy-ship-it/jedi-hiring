{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-4-0/backup-coordination-record-v1.schema.json",
  "title": "JEDI Atlas D9.4.0 D9.5 coordination directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_kind_code",
    "record_code",
    "operation_id",
    "operation_nonce",
    "subject",
    "chain",
    "basis_control_record_digest_sha256",
    "control_ledger_head_receipt_digest_sha256",
    "directive_code",
    "backup_state_code",
    "d95_execution_authority_code",
    "d95_backup_receipt_record_digest_sha256",
    "semantic_actor",
    "persistence_actor",
    "knowledge_boundary",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-backup-coordination-record" },
    "format_version": { "const": "1.0.0" },
    "record_kind_code": { "enum": ["restriction_directive", "tombstone_directive", "deletion_pending", "restore_guard"] },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
    "subject": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/subject" },
    "chain": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/chain" },
    "basis_control_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "control_ledger_head_receipt_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "directive_code": { "enum": ["apply_restriction_before_restore", "apply_tombstone_before_restore", "do_not_restore", "delete_backup_copy_after_d9_5_authorization"] },
    "backup_state_code": { "enum": ["unknown", "not_implemented", "present", "absent_unverified", "action_pending_d9_5"] },
    "d95_execution_authority_code": { "const": "unreachable_until_separately_approved_d9_5" },
    "d95_backup_receipt_record_digest_sha256": { "type": "null" },
    "semantic_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "knowledge_boundary": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/knowledgeBoundary" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  }
}
