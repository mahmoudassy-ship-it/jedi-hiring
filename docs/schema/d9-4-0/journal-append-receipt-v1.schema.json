{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-4-0/journal-append-receipt-v1.schema.json",
  "title": "JEDI Atlas D9.4.0 protected-ledger append acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "journal_namespace_code",
    "receipt_sequence",
    "previous_receipt_record_digest_sha256",
    "target_format",
    "target_record_code",
    "target_record_digest_sha256",
    "target_subject_identity_sha256",
    "operation_id",
    "operation_nonce",
    "semantic_actor",
    "persistence_actor",
    "semantic_recorded_at",
    "persisted_at",
    "durability_state_code",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-d940-journal-append-receipt" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "journal_namespace_code": { "const": "d940.global.control-journal.v1" },
    "receipt_sequence": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/positiveSafeInteger" },
    "previous_receipt_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/nullableSha256" },
    "target_format": {
      "enum": [
        "jedi-atlas-custody-control-record",
        "jedi-atlas-access-revocation-record",
        "jedi-atlas-deletion-execution-record",
        "jedi-atlas-deletion-receipt",
        "jedi-atlas-backup-coordination-record",
        "jedi-atlas-d940-recovery-assessment"
      ]
    },
    "target_record_code": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "target_record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "target_subject_identity_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" },
    "operation_id": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/operationNonce" },
    "semantic_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "https://jedi-hiring.invalid/schema/d9-4-0/common-v1.schema.json#/$defs/actor" },
    "semantic_recorded_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/timestamp" },
    "durability_state_code": { "const": "record_and_receipt_flushed_in_protected_d940_ledger" },
    "record_digest_sha256": { "$ref": "https://jedi-hiring.invalid/schema/d9-0/common-v1.schema.json#/$defs/sha256" }
  }
}
