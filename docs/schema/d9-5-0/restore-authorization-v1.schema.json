{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/restore-authorization-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 restore authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "operation_id",
    "operation_nonce",
    "requester",
    "backup_set_code",
    "backup_manifest_record_digest_sha256",
    "source_checkpoint_record_digest_sha256",
    "target_environment_identity_sha256",
    "authorization_scope_sha256",
    "approvals",
    "valid_from",
    "valid_until",
    "persistence_broker",
    "persisted_at",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-restore-authorization" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requester": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_manifest_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "source_checkpoint_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "target_environment_identity_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "authorization_scope_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "approvals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "common-v1.schema.json#/$defs/humanApproval" }
    },
    "valid_from": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "valid_until": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "persistence_broker": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persisted_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
