{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/restore-plan-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 deterministic restore plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "operation_id",
    "operation_nonce",
    "restore_mode_code",
    "backup_set_code",
    "backup_manifest_record_digest_sha256",
    "backup_receipt_record_digests",
    "source_checkpoint",
    "authorization_record_digest_sha256",
    "target_environment",
    "pre_restore_control_snapshot",
    "control_directives",
    "deletion_aware_reconstruction_record_digests",
    "retention_control_record_digest_sha256",
    "retention_control_chain_sequence",
    "retention_head",
    "ordered_stage_codes",
    "executor",
    "control_state_verifier",
    "restored_state_verifier",
    "persistence_broker",
    "planned_at",
    "expires_at",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-restore-plan" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "restore_mode_code": { "enum": ["authorized_reconstruction", "synthetic_drill"] },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_manifest_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "backup_receipt_record_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "common-v1.schema.json#/$defs/sha256" }
    },
    "source_checkpoint": { "$ref": "common-v1.schema.json#/$defs/sourceCheckpoint" },
    "authorization_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "target_environment": { "$ref": "common-v1.schema.json#/$defs/targetEnvironment" },
    "pre_restore_control_snapshot": { "$ref": "common-v1.schema.json#/$defs/knowledgeBoundary" },
    "control_directives": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "common-v1.schema.json#/$defs/controlDirective" }
    },
    "deletion_aware_reconstruction_record_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "common-v1.schema.json#/$defs/sha256" }
    },
    "retention_control_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "retention_control_chain_sequence": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
    "retention_head": { "$ref": "common-v1.schema.json#/$defs/retentionHeadReference" },
    "ordered_stage_codes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        { "const": "authorized" },
        { "const": "staging_started" },
        { "const": "bytes_reconstructed_inaccessible" },
        { "const": "controls_revalidated" },
        { "const": "controls_applied" },
        { "const": "staged_state_verified" },
        { "const": "promotion_started" },
        { "const": "promoted" },
        { "const": "post_promotion_verified" },
        { "const": "completed" }
      ],
      "items": false
    },
    "executor": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "control_state_verifier": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "restored_state_verifier": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persistence_broker": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "planned_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
