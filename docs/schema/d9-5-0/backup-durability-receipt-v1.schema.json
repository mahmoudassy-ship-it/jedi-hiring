{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/backup-durability-receipt-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 bounded backup durability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "receipt_kind_code",
    "scope_profile_code",
    "scope",
    "scope_sha256",
    "backup_profile_record_digest_sha256",
    "operation_id",
    "operation_nonce",
    "backup_set_code",
    "backup_manifest_record_digest_sha256",
    "source_checkpoint_record_digest_sha256",
    "copy_identity",
    "verification",
    "durability",
    "producer",
    "independent_verifier",
    "persistence_broker",
    "completed_at",
    "persisted_at",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-backup-durability-receipt" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "receipt_kind_code": { "enum": ["source_copy", "artifact_copy", "prior_database", "final_consistent_set"] },
    "scope_profile_code": {
      "enum": [
        "source_copy_operation_nonce_v1",
        "artifact_bundle_copy_primary_receipt_operation_nonce_v1",
        "prior_logical_state_database_generation_operation_nonce_v1",
        "resulting_logical_state_receipt_head_inventory_operation_nonce_v1"
      ]
    },
    "scope_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "scope": {
      "oneOf": [
        { "$ref": "#/$defs/sourceCopyScope" },
        { "$ref": "#/$defs/artifactCopyScope" },
        { "$ref": "#/$defs/priorDatabaseScope" },
        { "$ref": "#/$defs/finalConsistentSetScope" }
      ]
    },
    "backup_profile_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_manifest_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "source_checkpoint_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "copy_identity": { "$ref": "common-v1.schema.json#/$defs/copyIdentity" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_code", "recomputed_sha256", "recomputed_byte_length", "manifest_match", "source_checkpoint_match"],
      "properties": {
        "outcome_code": { "const": "passed" },
        "recomputed_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
        "recomputed_byte_length": { "$ref": "common-v1.schema.json#/$defs/nonNegativeInteger" },
        "manifest_match": { "const": true },
        "source_checkpoint_match": { "const": true }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_replace_enforced", "object_data_synchronized", "parent_namespace_synchronized", "final_reopen_rehash_passed", "bounded_durability_code"],
      "properties": {
        "no_replace_enforced": { "const": true },
        "object_data_synchronized": { "const": true },
        "parent_namespace_synchronized": { "const": true },
        "final_reopen_rehash_passed": { "const": true },
        "bounded_durability_code": { "const": "component_observation_not_power_loss_guarantee" }
      }
    },
    "producer": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "independent_verifier": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persistence_broker": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "completed_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "receipt_kind_code": { "const": "source_copy" } }, "required": ["receipt_kind_code"] },
      "then": {
        "properties": {
          "scope_profile_code": { "const": "source_copy_operation_nonce_v1" },
          "scope": { "$ref": "#/$defs/sourceCopyScope" }
        }
      }
    },
    {
      "if": { "properties": { "receipt_kind_code": { "const": "artifact_copy" } }, "required": ["receipt_kind_code"] },
      "then": {
        "properties": {
          "scope_profile_code": { "const": "artifact_bundle_copy_primary_receipt_operation_nonce_v1" },
          "scope": { "$ref": "#/$defs/artifactCopyScope" }
        }
      }
    },
    {
      "if": { "properties": { "receipt_kind_code": { "const": "prior_database" } }, "required": ["receipt_kind_code"] },
      "then": {
        "properties": {
          "scope_profile_code": { "const": "prior_logical_state_database_generation_operation_nonce_v1" },
          "scope": { "$ref": "#/$defs/priorDatabaseScope" }
        }
      }
    },
    {
      "if": { "properties": { "receipt_kind_code": { "const": "final_consistent_set" } }, "required": ["receipt_kind_code"] },
      "then": {
        "properties": {
          "scope_profile_code": { "const": "resulting_logical_state_receipt_head_inventory_operation_nonce_v1" },
          "scope": { "$ref": "#/$defs/finalConsistentSetScope" }
        }
      }
    }
  ],
  "$defs": {
    "sourceCopyScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copy_code", "artifact", "operation_id", "operation_nonce"],
      "properties": {
        "copy_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
        "artifact": { "$ref": "common-v1.schema.json#/$defs/artifactIdentity" },
        "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
        "operation_nonce": { "$ref": "common-v1.schema.json#/$defs/sha256" }
      }
    },
    "artifactCopyScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "artifact", "copy_code", "primary_receipt", "operation_id", "operation_nonce"],
      "properties": {
        "bundle": { "$ref": "common-v1.schema.json#/$defs/bundleReference" },
        "artifact": { "$ref": "common-v1.schema.json#/$defs/artifactIdentity" },
        "copy_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
        "primary_receipt": { "$ref": "common-v1.schema.json#/$defs/primaryReceiptReference" },
        "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
        "operation_nonce": { "$ref": "common-v1.schema.json#/$defs/sha256" }
      }
    },
    "priorDatabaseScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "prior_logical_state", "database_generation", "operation_id", "operation_nonce"],
      "properties": {
        "bundle": { "$ref": "common-v1.schema.json#/$defs/bundleReference" },
        "prior_logical_state": { "$ref": "common-v1.schema.json#/$defs/logicalStateReference" },
        "database_generation": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
        "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
        "operation_nonce": { "$ref": "common-v1.schema.json#/$defs/sha256" }
      }
    },
    "finalConsistentSetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "resulting_logical_state", "receipt_head", "constituent_receipt_record_digests", "inventory_digest_sha256", "operation_id", "operation_nonce"],
      "properties": {
        "bundle": { "$ref": "common-v1.schema.json#/$defs/bundleReference" },
        "resulting_logical_state": { "$ref": "common-v1.schema.json#/$defs/logicalStateReference" },
        "receipt_head": { "$ref": "common-v1.schema.json#/$defs/journalHeadReference" },
        "constituent_receipt_record_digests": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "common-v1.schema.json#/$defs/sha256" }
        },
        "inventory_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
        "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
        "operation_nonce": { "$ref": "common-v1.schema.json#/$defs/sha256" }
      }
    }
  }
}
