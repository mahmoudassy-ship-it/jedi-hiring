{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/restore-drill-record-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 append-only synthetic restore-drill record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "drill_code",
    "chain",
    "backup_set_code",
    "backup_manifest_record_digest_sha256",
    "restore_plan_record_digest_sha256",
    "target_environment_identity_sha256",
    "expected_source_checkpoint",
    "observed_source_checkpoint_record_digest_sha256",
    "observed_source_state_head_digest_sha256",
    "observed_correspondence_record_digest_sha256",
    "expected_backup_chain_leaf_record_digest_sha256",
    "expected_backup_chain_leaf_sequence",
    "observed_backup_chain_leaf_record_digest_sha256",
    "observed_backup_chain_leaf_sequence",
    "expected_inventory_digest_sha256",
    "restored_inventory_digest_sha256",
    "checkpoint_age_basis_code",
    "scheduled_for",
    "started_at",
    "completed_at",
    "checkpoint_age_seconds",
    "checkpoint_age_limit_seconds",
    "backup_chain_state_code",
    "source_head_comparison_code",
    "restored_state_comparison_code",
    "outcome_code",
    "escalation_code",
    "scheduler",
    "independent_verifier",
    "persistence_broker",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-restore-drill-record" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "drill_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "chain": { "$ref": "common-v1.schema.json#/$defs/appendChain" },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_manifest_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "restore_plan_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "target_environment_identity_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "expected_source_checkpoint": { "$ref": "common-v1.schema.json#/$defs/sourceCheckpoint" },
    "observed_source_checkpoint_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "observed_source_state_head_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "observed_correspondence_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "expected_backup_chain_leaf_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "expected_backup_chain_leaf_sequence": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
    "observed_backup_chain_leaf_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "observed_backup_chain_leaf_sequence": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
    "expected_inventory_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "restored_inventory_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "checkpoint_age_basis_code": { "const": "started_at_minus_checkpoint_captured_at_floor_seconds" },
    "scheduled_for": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "started_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "completed_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "checkpoint_age_seconds": { "$ref": "common-v1.schema.json#/$defs/nonNegativeInteger" },
    "checkpoint_age_limit_seconds": { "const": 86400 },
    "backup_chain_state_code": { "enum": ["current_leaf", "superseded"] },
    "source_head_comparison_code": { "enum": ["exact_checkpoint_match", "mismatch"] },
    "restored_state_comparison_code": { "enum": ["exact_match", "mismatch"] },
    "outcome_code": { "enum": ["passed", "failed", "stale"] },
    "escalation_code": { "enum": ["none", "new_backup_required", "security_review_required"] },
    "scheduler": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "independent_verifier": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persistence_broker": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
