{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/retention-head-attestation-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 protected retention-ledger head attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "operation_id",
    "operation_nonce",
    "backup_set_code",
    "backup_manifest_record_digest_sha256",
    "namespace_code",
    "head_sequence",
    "head_record_digest_sha256",
    "head_receipt_record_digest_sha256",
    "head_receipt_persisted_at",
    "observed_by",
    "observed_at",
    "known_at",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-retention-head-attestation" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_manifest_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "namespace_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "head_sequence": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
    "head_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "head_receipt_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "head_receipt_persisted_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "observed_by": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "observed_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "known_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
