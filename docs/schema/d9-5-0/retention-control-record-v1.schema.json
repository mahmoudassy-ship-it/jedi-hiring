{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/retention-control-record-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 append-only backup retention and hold control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "chain",
    "backup_set_code",
    "backup_manifest_record_digest_sha256",
    "decision_code",
    "retention_class_code",
    "retain_until",
    "hold_state_code",
    "deletion_authority_present",
    "reason_code",
    "semantic_actor",
    "persistence_actor",
    "effective_at",
    "recorded_at",
    "persisted_at",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-backup-retention-control" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "chain": { "$ref": "common-v1.schema.json#/$defs/appendChain" },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_manifest_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "decision_code": { "enum": ["retain", "hold", "release_hold", "deletion_review_required", "deletion_authorized_separately"] },
    "retention_class_code": { "enum": ["pilot_short_term", "operational_standard", "legal_hold"] },
    "retain_until": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "hold_state_code": { "enum": ["none_known", "hold_active", "unknown"] },
    "deletion_authority_present": { "const": false },
    "reason_code": { "enum": ["initial_retention", "scheduled_review", "legal_hold_asserted", "legal_hold_released", "separate_deletion_process_required"] },
    "semantic_actor": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "effective_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "recorded_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
