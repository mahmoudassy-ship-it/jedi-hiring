{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/backup-manifest-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 canonical backup-set manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "operation_id",
    "operation_nonce",
    "backup_set_code",
    "backup_chain_sequence",
    "previous_backup_manifest_record_digest_sha256",
    "source_checkpoint",
    "source_inventory",
    "source_inventory_digest_sha256",
    "backup_copies",
    "source_copy_coverage",
    "backup_copy_inventory_digest_sha256",
    "retention",
    "producer",
    "persistence_broker",
    "created_at",
    "persisted_at",
    "technical_claims",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-backup-set-manifest" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "backup_set_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "backup_chain_sequence": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
    "previous_backup_manifest_record_digest_sha256": {
      "oneOf": [
        { "$ref": "common-v1.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "source_checkpoint": { "$ref": "common-v1.schema.json#/$defs/sourceCheckpoint" },
    "source_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "common-v1.schema.json#/$defs/inventoryEntry" }
    },
    "source_inventory_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "backup_copies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "common-v1.schema.json#/$defs/copyIdentity" }
    },
    "source_copy_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "common-v1.schema.json#/$defs/sourceCopyCoverage" }
    },
    "backup_copy_inventory_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_class_code", "retain_until", "hold_state_code", "expiry_action_code"],
      "properties": {
        "retention_class_code": { "enum": ["pilot_short_term", "operational_standard", "legal_hold"] },
        "retain_until": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "hold_state_code": { "enum": ["none_known", "hold_active", "unknown"] },
        "expiry_action_code": { "const": "human_review_required_no_automatic_deletion" }
      }
    },
    "producer": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persistence_broker": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "created_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "technical_claims": { "$ref": "common-v1.schema.json#/$defs/technicalClaims" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
