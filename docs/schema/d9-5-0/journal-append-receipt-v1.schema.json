{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-5-0/journal-append-receipt-v1.schema.json",
  "title": "JEDI Atlas D9.5.0 protected journal append receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "record_code",
    "journal_namespace_code",
    "receipt_sequence",
    "previous_receipt_record_digest_sha256",
    "target_format",
    "target_record_code",
    "target_record_digest_sha256",
    "operation_id",
    "operation_nonce",
    "semantic_actor",
    "persistence_actor",
    "semantic_recorded_at",
    "persisted_at",
    "durability_state_code",
    "record_digest_sha256"
  ],
  "properties": {
    "format": { "const": "jedi-atlas-d950-journal-append-receipt" },
    "format_version": { "const": "1.0.0" },
    "record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "journal_namespace_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "receipt_sequence": { "$ref": "common-v1.schema.json#/$defs/positiveInteger" },
    "previous_receipt_record_digest_sha256": {
      "oneOf": [
        { "$ref": "common-v1.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "target_format": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "target_record_code": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "target_record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" },
    "operation_id": { "$ref": "common-v1.schema.json#/$defs/stableCode" },
    "operation_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semantic_actor": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "common-v1.schema.json#/$defs/actor" },
    "semantic_recorded_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "durability_state_code": { "const": "record_and_receipt_flushed_in_protected_d950_ledger" },
    "record_digest_sha256": { "$ref": "common-v1.schema.json#/$defs/sha256" }
  }
}
