    "subject": { "$ref": "common-v1-3.schema.json#/$defs/subject" },
    "append_request_record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "append_broker_receipt_record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "pre_append_checkpoint_identity_record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "post_checkpoint_sequence": { "$ref": "common-v1-3.schema.json#/$defs/positiveInteger" },
    "post_checkpoint_cas_identity_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "pre_append_correspondence": { "$ref": "common-v1-3.schema.json#/$defs/correspondenceReference" },
    "post_append_correspondence": { "$ref": "common-v1-3.schema.json#/$defs/correspondenceReference" },
