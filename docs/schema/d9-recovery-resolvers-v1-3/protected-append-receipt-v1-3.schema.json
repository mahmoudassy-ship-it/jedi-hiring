{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-3/protected-append-receipt-v1-3.schema.json",
  "title": "Protected v1.3 correction-namespace append receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "receipt_code", "namespace_code", "sequence", "predecessor_receipt_record_digest_sha256", "payload_format", "payload_record_digest_sha256", "source_head_cas_digest_sha256", "semantic_actor", "persistence_actor", "accepted_at", "persisted_at", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-recovery-source-identity-protected-append-receipt" },
    "format_version": { "const": "1.3.0" },
    "receipt_code": { "$ref": "common-v1-3.schema.json#/$defs/stableCode" },
    "namespace_code": { "enum": ["d9.resolver.source-head-correspondence.v1.3", "d9.resolver.identity-corrections.v1.3"] },
    "sequence": { "$ref": "common-v1-3.schema.json#/$defs/positiveInteger" },
    "predecessor_receipt_record_digest_sha256": { "oneOf": [{ "$ref": "common-v1-3.schema.json#/$defs/sha256" }, { "type": "null" }] },
    "payload_format": { "enum": ["jedi-atlas-d940-source-head-receipt-correspondence", "jedi-atlas-recovery-checkpoint-source-identity", "jedi-atlas-recovery-assessment-append-request", "jedi-atlas-recovery-assessment-append-broker-receipt", "jedi-atlas-recovery-checkpoint-transition", "jedi-atlas-recovery-assessment-source-identity-link", "jedi-atlas-d940-control-access-projection"] },
    "payload_record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "source_head_cas_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "semantic_actor": { "$ref": "common-v1-3.schema.json#/$defs/actor" },
    "persistence_actor": { "$ref": "common-v1-3.schema.json#/$defs/actor" },
    "accepted_at": { "$ref": "common-v1-3.schema.json#/$defs/timestamp" },
    "persisted_at": { "$ref": "common-v1-3.schema.json#/$defs/timestamp" },
    "record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" }
  },
  "allOf": [{
    "if": { "properties": { "sequence": { "const": 1 } }, "required": ["sequence"] },
    "then": { "properties": { "predecessor_receipt_record_digest_sha256": { "type": "null" } } },
    "else": { "properties": { "predecessor_receipt_record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" } } }
  }]
}
