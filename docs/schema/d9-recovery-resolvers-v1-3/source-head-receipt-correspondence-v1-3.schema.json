{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedi-hiring.invalid/schema/d9-recovery-resolvers-v1-3/source-head-receipt-correspondence-v1-3.schema.json",
  "title": "Exact D9.4 state-head and journal-tip correspondence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "correspondence_code", "operation_id", "operation_nonce", "runtime_generation", "state_head", "journal_tip", "authenticated_receipt_prefix", "raw_payload_commitments", "raw_prefix_digest_sha256", "semantic_verifier_actor", "persistence_broker_actor", "observed_at", "technical_journal_continuity_only", "authority_granted", "record_digest_sha256"],
  "properties": {
    "format": { "const": "jedi-atlas-d940-source-head-receipt-correspondence" },
    "format_version": { "const": "1.3.0" },
    "correspondence_code": { "$ref": "common-v1-3.schema.json#/$defs/stableCode" },
    "operation_id": { "$ref": "common-v1-3.schema.json#/$defs/stableCode" },
    "operation_nonce": { "$ref": "common-v1-3.schema.json#/$defs/operationNonce" },
    "runtime_generation": { "$ref": "common-v1-3.schema.json#/$defs/runtimeGeneration" },
    "state_head": { "$ref": "common-v1-3.schema.json#/$defs/d940StateHead" },
    "journal_tip": { "$ref": "common-v1-3.schema.json#/$defs/d940JournalTip" },
    "authenticated_receipt_prefix": { "type": "array", "minItems": 0, "maxItems": 100000, "items": { "$ref": "common-v1-3.schema.json#/$defs/receiptPrefixEntry" } },
    "raw_payload_commitments": { "type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{ "$ref": "common-v1-3.schema.json#/$defs/rawPayloadCommitment" }], "items": false },
    "raw_prefix_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" },
    "semantic_verifier_actor": { "$ref": "common-v1-3.schema.json#/$defs/actor" },
    "persistence_broker_actor": { "$ref": "common-v1-3.schema.json#/$defs/actor" },
    "observed_at": { "$ref": "common-v1-3.schema.json#/$defs/timestamp" },
    "technical_journal_continuity_only": { "const": true },
    "authority_granted": { "const": false },
    "record_digest_sha256": { "$ref": "common-v1-3.schema.json#/$defs/sha256" }
  }
}
