{
  "name": "jedi-hiring-legal-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "predev": "npm run data:build",
    "dev": "node scripts/dev.mjs",
    "data:build": "node --disable-warning=ExperimentalWarning data/scripts/migrate.mjs",
    "data:check": "node --disable-warning=ExperimentalWarning data/scripts/check.mjs",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "schema:validate": "npm run schema:validate:tranche-1a && npm run schema:validate:tranche-2a && npm run schema:validate:d9-0",
    "schema:validate:tranche-1a": "node --disable-warning=ExperimentalWarning docs/schema/validate-tranche-1a.mjs",
    "schema:validate:tranche-2a": "node --disable-warning=ExperimentalWarning docs/schema/validate-tranche-2a.mjs",
    "schema:validate:d9-0": "node --disable-warning=ExperimentalWarning docs/schema/validate-d9-0.mjs",
    "security:check": "node scripts/check-secrets.mjs",
    "check": "npm run data:build && npm run data:check && npm run schema:validate && npm test && npm run build && npm run security:check"
  }
}
